# Base URL of the shared Click API. Relative in dev (Vite proxies /api -> Django on :4000).
VITE_API_BASE_URL=/api/v1
# Discovery data source: "api" (real Django data) or "mock" (TEMPORARY MOCK DATA in src/mock).
VITE_STORES_SOURCE=api

# --- Phone sign-in (identity provider) ----------------------------------
# Which phone-OTP provider the app uses. Swap providers by adding an adapter in src/auth/phone/.
VITE_PHONE_AUTH_PROVIDER=firebase
# Firebase *web* app config (public client identifiers, not secrets). Put real values in
# apps/customer/.env.local (git-ignored). Never put service-account/Admin keys in the frontend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional, development only: use the local Firebase Auth Emulator, e.g. 127.0.0.1:9099
VITE_FIREBASE_AUTH_EMULATOR_HOST=

# --- Ride map ----------------------------------------------------------------
# XYZ tile URL + attribution for the Ride map (Leaflet). Empty = OpenStreetMap's public tiles, which are for light
# development use only; production needs its own tile provider. Google Maps is not used.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
