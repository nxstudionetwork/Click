# Base URL of the shared Click API. Relative in dev (Vite proxies /api -> Django).
VITE_API_BASE_URL=/api/v1

# Firebase Web SDK configuration for Click Partner phone sign-in.
# These are public client identifiers (not secrets) from Firebase console >
# Project settings > Your apps > Web app. Never put service-account keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional (same values as the Customer App).
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=

# Local development only: use the Firebase Auth Emulator instead of real SMS (see docs/authentication.md)
# and set FIREBASE_AUTH_EMULATOR_HOST to the same host in backend/.env.
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
