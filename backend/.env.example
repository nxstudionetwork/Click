# Copy to backend/.env for local development. Never commit real secrets.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me-to-a-long-random-string-0000
DATABASE_URL=postgres://click:click@localhost:5432/click
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CLICK_DEFAULT_CURRENCY=INR
CLICK_TAX_RATE=0.05
CLICK_DEV_PORT=4000
# Phone OTP delivery. Empty in production until the SMS provider is configured (sign-in then reports
# "temporarily unavailable"); "console" in development prints codes in this terminal. Point it at your provider's
# sender class (see apps/identity/sms.py) and put that provider's credentials in this file, never in code.
CLICK_SMS_PROVIDER=console
# Ready-made senders: "msg91" (India, DLT template) or "twilio". Fill in only the one you use:
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=
# Payment provider for adding money / online checkout. Empty = sandbox test mode in development only.
# "razorpay" needs the three keys below; set the webhook URL in Razorpay to
#   https://<your-api-host>/api/v1/payments/webhooks/razorpay  (events: payment.captured, payment.failed, order.paid)
# CLICK_PAYMENT_PROVIDER=
# CLICK_PAYMENT_WEBHOOK_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Maps (apps.geo): empty in production until you host Photon / OSRM or contract a provider.
# CLICK_GEOCODER_URL=
# CLICK_ROUTER_URL=
