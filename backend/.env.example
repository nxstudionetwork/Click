# Copy to backend/.env for local development. Never commit real secrets.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me-to-a-long-random-string-0000
DATABASE_URL=postgres://click:click@localhost:5432/click
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CLICK_DEFAULT_CURRENCY=INR
CLICK_TAX_RATE=0.05
CLICK_DEV_PORT=4000
# Phone OTP delivery. Empty in production until the SMS provider is configured (sign-in then reports
# "temporarily unavailable"); "console" in development prints codes in this terminal. Point it at your provider's
# sender class (see apps/identity/sms.py) and put that provider's credentials in this file, never in code.
CLICK_SMS_PROVIDER=console
# Payment provider for adding money / online checkout. Empty = sandbox test mode in development only.
# CLICK_PAYMENT_PROVIDER=
# CLICK_PAYMENT_WEBHOOK_SECRET=
