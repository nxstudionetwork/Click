# Copy to backend/.env for local development. Never commit real secrets.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me-to-a-long-random-string-0000
DATABASE_URL=postgres://click:click@localhost:5432/click
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CLICK_DEFAULT_CURRENCY=INR
CLICK_TAX_RATE=0.05
# Click Partner: Firebase project used for phone sign-in (public project ID, not a secret).
FIREBASE_PROJECT_ID=
# Local development only, with `firebase emulators:start --only auth`:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
